function revisionDate_(){return Utilities.formatDate(new Date(),APP.TIMEZONE,'dd/MM/yyyy');}
function normalizeRevisionHistory_(type,history,edition,change,responsible,approver){if(type==='FOR')return [];const rows=(history||[]).map(function(x){return {edicao:normalize_(x.edicao),data:normalize_(x.data),responsavel:normalize_(x.responsavel),aprovador:normalize_(x.aprovador),alteracoes:normalize_(x.alteracoes)};}).filter(function(x){return x.edicao;});let row=rows.find(function(x){return x.edicao===edition;});const first=editionNumber_(edition)===1;if(!row){row={edicao:edition,data:revisionDate_(),responsavel:normalize_(responsible),aprovador:normalize_(approver),alteracoes:first?'Criação':normalize_(change)};rows.push(row);}else{row.responsavel=normalize_(responsible)||row.responsavel;row.aprovador=normalize_(approver)||row.aprovador;if(first)row.alteracoes='Criação';else if(normalize_(change))row.alteracoes=normalize_(change);}if(!first&&!row.alteracoes)throw new Error('Informe as alterações realizadas nesta revisão.');return rows.sort(function(a,b){return editionNumber_(a.edicao)-editionNumber_(b.edicao);});}

