    let doc=null;if(String(a.Entidade)==='Documento')doc=docMap[String(a.EntidadeId)];
    else if(String(a.Entidade)==='Treinamento'){const trainingId=split_(a.EntidadeId)[0],training=trainingMap[String(trainingId)];doc=training&&docMap[String(training.DocumentoId)];}
