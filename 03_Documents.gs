function dashboardActionLabel_(action){const labels={ALTEROU:'atualização',CRIOU:'criação',INICIOU_REVISAO:'início de revisão',ENVIOU_APROVACAO:'envio para aprovação',VALIDOU_FLUXO:'validação do fluxo',APROVOU:'aprovação',REJEITOU:'recusa',PUBLICOU:'publicação',SOLICITOU_OBSOLESCENCIA:'solicitação de obsolescência',APROVOU_OBSOLESCENCIA:'aprovação da obsolescência',REJEITOU_OBSOLESCENCIA:'recusa da obsolescência',TORNOU_OBSOLETO:'obsolescência',SOLICITOU_REATIVACAO:'solicitação de reativação',APROVOU_REATIVACAO:'aprovação da reativação',REJEITOU_REATIVACAO:'recusa da reativação',REATIVOU:'reativação',REGISTROU_LOTE:'registro de treinamento',AVALIOU_EFICACIA_LOTE:'avaliação de eficácia',PRORROGOU_EFICACIA:'prorrogação de eficácia'};return labels[String(action||'')]||String(action||'atualização').toLowerCase().replace(/_/g,' ');}

function listarDocumentos(token,filters){return publicCall_(function(){const s=session_(token);filters=filters||{};let rows=authorizedDocs_(s);if(filters.tipo)rows=rows.filter(function(x){return String(x.Tipo)===String(filters.tipo);});if(filters.setor)rows=rows.filter(function(x){return String(x.SetorId)===String(filters.setor);});if(filters.status==='Em criação ou revisão')rows=rows.filter(function(x){return ['Em criação','Em revisão'].indexOf(String(x.Status))>=0;});else if(filters.status)rows=rows.filter(function(x){return String(x.Status)===String(filters.status);});if(filters.q){const q=normalize_(filters.q).toLowerCase();rows=rows.filter(function(x){return [x.Codigo,x.Titulo,x.Setor,x.AutorNome].join(' ').toLowerCase().indexOf(q)>=0;});}return rows.sort(function(a,b){return String(b.AtualizadoEm).localeCompare(String(a.AtualizadoEm));}).map(cleanRow_);});}
